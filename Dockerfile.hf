# syntax=docker/dockerfile:1.7
# Standalone HF Spaces image. Copy this file to Dockerfile in the Space repo.
# Source is fetched at a reviewed SHA; only deployment helpers use COPY.
FROM debian:13.4 AS sqlite_build
ARG SQLITE_AUTOCONF_VERSION=3530400
ARG SQLITE_SHA256=0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get install -y --no-install-recommends build-essential ca-certificates curl && \
    (curl -fsSL --retry 2 --connect-timeout 15 --max-time 120 \
      "https://sqlite.org/2026/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}.tar.gz" -o /tmp/sqlite.tar.gz || \
     curl -fsSL --retry 3 --connect-timeout 15 --max-time 120 \
      "https://sources.buildroot.net/sqlite/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}.tar.gz" -o /tmp/sqlite.tar.gz) && \
    printf '%s  %s\n' "$SQLITE_SHA256" /tmp/sqlite.tar.gz | sha256sum -c - && \
    tar -xzf /tmp/sqlite.tar.gz -C /tmp && \
    cd "/tmp/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}" && \
    CFLAGS="-O2 -DSQLITE_ENABLE_FTS3 -DSQLITE_ENABLE_FTS3_PARENTHESIS -DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_RTREE -DSQLITE_ENABLE_GEOPOLY -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_UNLOCK_NOTIFY -DSQLITE_ENABLE_DBSTAT_VTAB -DSQLITE_ENABLE_DBPAGE_VTAB -DSQLITE_ENABLE_MATH_FUNCTIONS -DSQLITE_ENABLE_PREUPDATE_HOOK -DSQLITE_ENABLE_SESSION -DSQLITE_SECURE_DELETE -DSQLITE_THREADSAFE=1 -DSQLITE_MAX_VARIABLE_NUMBER=250000" \
      ./configure --prefix=/opt/sqlite-fixed --disable-static && \
    make -j"$(nproc)" && make install

# Keep toolchain digests aligned with the production Dockerfile.
FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source
FROM node:26-bookworm-slim@sha256:9e6f9357d371591e32ab6f2d8a26d63bdd0d17c29eee3f4f3e7e454d9634bf73 AS node_source
FROM debian:13.4

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/Hermes \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/bin/python3 \
    UV_PROJECT_ENVIRONMENT=/home/Hermes/hermes-agent/.venv \
    HERMES_HOME=/home/Hermes/.hermes \
    HF_STATE_MODE=unconfigured \
    HF_PORT=7860

RUN apt-get -o Acquire::Retries=3 update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl git python3 python3-dev python3-venv \
      build-essential libffi-dev libolm-dev libatomic1 sudo tini \
      ffmpeg procps ripgrep openssh-client util-linux iputils-ping && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 1000 Hermes && \
    useradd --uid 1000 --gid 1000 --create-home --home-dir /home/Hermes --shell /bin/bash Hermes && \
    printf 'Hermes ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/Hermes && \
    chmod 0440 /etc/sudoers.d/Hermes && visudo -cf /etc/sudoers.d/Hermes && \
    install -d -o Hermes -g Hermes -m 0700 /home/Hermes/.hermes && \
    install -d -o Hermes -g Hermes -m 0750 /data

COPY --from=sqlite_build /opt/sqlite-fixed/lib/libsqlite3.so.3.53.4 /usr/local/lib/
RUN ln -sf libsqlite3.so.3.53.4 /usr/local/lib/libsqlite3.so.0 && \
    ln -sf libsqlite3.so.3.53.4 /usr/local/lib/libsqlite3.so && \
    printf '/usr/local/lib\n' > /etc/ld.so.conf.d/000-sqlite-fixed.conf && ldconfig && \
    python3 -c "import sqlite3,sys; sys.exit('unsafe SQLite '+sqlite3.sqlite_version) if sqlite3.sqlite_version_info < (3,51,3) else None; db=sqlite3.connect(':memory:'); db.execute(\"CREATE VIRTUAL TABLE docs USING fts5(content, tokenize='trigram')\"); db.execute(\"INSERT INTO docs VALUES ('hermes')\"); sys.exit('FTS5 trigram check failed') if db.execute(\"SELECT count(*) FROM docs WHERE docs MATCH 'erm'\").fetchone()[0] != 1 else None"

COPY --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/
COPY --from=node_source /usr/local/bin/node /usr/local/bin/
COPY --from=node_source /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ARG HERMES_REPO_URL=https://github.com/filewrap/hermes-agent.git
# Application and helper revisions are independent: never self-pin this helper commit.
ARG HERMES_REF=a0923910e33f78f3487311a202c8803934c879b7
USER Hermes
WORKDIR /home/Hermes
# Secret file must be readable by UID1000. Never place the token in ARG/ENV/URL.
RUN --mount=type=secret,id=GITHUB_TOKEN,required=false,mode=0444 \
    set -eu; \
    case "$HERMES_REF" in *[!0-9a-f]*|'') echo 'HERMES_REF must be a full lowercase SHA' >&2; exit 1;; esac; \
    [ "${#HERMES_REF}" = 40 ] || { echo 'HERMES_REF must contain 40 characters' >&2; exit 1; }; \
    case "$HERMES_REPO_URL" in https://github.com/*) ;; *) echo 'Only credential-free github.com HTTPS sources are supported' >&2; exit 1;; esac; \
    case "$HERMES_REPO_URL" in *'@'*|*'?'*|*'#'*) echo 'Source URL must not contain credentials, query or fragment' >&2; exit 1;; esac; \
    askpass="$(mktemp)"; trap 'rm -f "$askpass"' EXIT HUP INT TERM; \
    printf '%s\n' '#!/bin/sh' 'case "$1" in *Username*) printf "%s\n" x-access-token;; *) cat /run/secrets/GITHUB_TOKEN;; esac' > "$askpass"; \
    chmod 0700 "$askpass"; \
    export GIT_TERMINAL_PROMPT=0; \
    if [ -s /run/secrets/GITHUB_TOKEN ]; then export GIT_ASKPASS="$askpass"; fi; \
    git init -q hermes-agent; \
    cd hermes-agent; \
    git remote add origin "$HERMES_REPO_URL"; \
    git fetch --depth=1 --no-tags origin "$HERMES_REF"; \
    git checkout -q --detach FETCH_HEAD; \
    [ "$(git rev-parse HEAD)" = "$HERMES_REF" ] || { echo 'Fetched revision mismatch' >&2; exit 1; }

WORKDIR /home/Hermes/hermes-agent
# The frozen source lock includes uvloop==0.22.1 on Linux CPython.
RUN uv sync --python /usr/bin/python3 --frozen --no-dev \
      --extra all --extra messaging --extra matrix --extra google-chat \
      --extra anthropic --extra bedrock --extra azure-identity --extra otlp --extra hindsight

ENV PATH="/home/Hermes/hermes-agent/.venv/bin:/usr/local/bin:/usr/bin:/bin" \
    PYTHONPATH=/home/Hermes/hermes-agent
COPY --chown=Hermes:Hermes deploy/huggingface/ /home/Hermes/hf/
# Validate actual gateway venv SQLite, pinned uvloop and gateway loop selection.
RUN .venv/bin/python /home/Hermes/hf/check_runtime.py && \
    .venv/bin/python -c "from agent.strict_free_policy import POLICY_VERSION; assert POLICY_VERSION >= 1, 'HF build blocked: strict free-only policy capability missing'"
COPY --chown=Hermes:Hermes --chmod=0755 deploy/huggingface/start.sh /usr/local/bin/hf-hermes-start
EXPOSE 7860
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hf-hermes-start"]
